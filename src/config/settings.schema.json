{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdexUi-2026 Settings Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shell": { "type": "string", "default": "" },
    "shellArgs": { "type": "string", "default": "" },
    "keyboard": { "type": "string", "default": "en-US" },
    "theme": { "type": "string", "default": "tron" },
    "termFontSize": { "type": "integer", "minimum": 8, "maximum": 48, "default": 15 },
    "audio": { "type": "boolean", "default": true },
    "audioVolume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
    "clockHours": { "type": "integer", "enum": [12, 24], "default": 24 },
    "pingAddr": { "type": "string", "default": "1.1.1.1" },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 3000 },
    "nointro": { "type": "boolean", "default": false },
    "nocursor": { "type": "boolean", "default": false },
    "forceFullscreen": { "type": "boolean", "default": false },
    "allowWindowed": { "type": "boolean", "default": true },
    "keepGeometry": { "type": "boolean", "default": true },
    "excludeThreadsFromToplist": { "type": "boolean", "default": true },
    "hideDotfiles": { "type": "boolean", "default": false },
    "fsListView": { "type": "boolean", "default": false },
    "termHardwareAcceleration": { "type": "boolean", "default": false },
    "enableVulkan": { "type": "boolean", "default": false },
    "disableVulkan": { "type": "boolean", "default": false },
    "optimizeVulkan": { "type": "boolean", "default": true },
    "termLigatures": { "type": "boolean", "default": false },
    "disableGlobe": { "type": "boolean", "default": false },
    "disableUpdateCheck": { "type": "boolean", "default": false },
    "experimentalGlobeFeatures": { "type": "boolean", "default": false },
    "experimentalFeatures": { "type": "boolean", "default": false },
    "visualQuality": { "type": "string", "enum": ["off", "minimal", "balanced", "cinematic"], "default": "balanced" },
    "reduceMotion": { "type": "boolean", "default": false }
  },
  "required": []
}
